PORT=5000
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated, e.g. https://ayushman.vercel.app)
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ayushman_os
# Set DB_SSL=true when connecting to cloud MySQL providers (Aiven, TiDB Cloud, PlanetScale, Railway)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT & Admin Authentication (Replace with strong random values in production)
JWT_SECRET=replace_with_strong_random_jwt_secret
ADMIN_USERNAME=ayushman
ADMIN_PASSWORD=replace_with_strong_admin_password

# External API Integrations (Optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TMDB_API_KEY=
